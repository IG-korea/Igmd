#!/usr/bin/env bash
# mdnotify: MD 시뮬레이션 종료 시 휴대폰 푸시 알림 전송 (ntfy / Telegram)
#
#   mdnotify send  "제목" "내용"                  # 단순 알림
#   mdnotify run   [--name N] [--log md.log] -- <명령...>   # 명령 실행 후 결과 알림
#   mdnotify watch [--name N] [--interval 60] [--pattern 정규식] <파일>   # 실행 중인 작업 감시
#   mdnotify test                                # 설정 확인용 테스트 알림
#
# 설정: ~/.mdnotify.conf (또는 환경변수 MDNOTIFY_CONF 로 경로 지정)
set -u

CONF="${MDNOTIFY_CONF:-$HOME/.mdnotify.conf}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"
NTFY_TOPIC="${NTFY_TOPIC:-}"
NTFY_TOKEN="${NTFY_TOKEN:-}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-}"
HOST="$(hostname -s 2>/dev/null || hostname)"

die() { echo "mdnotify: $*" >&2; exit 2; }

# ---------- 전송 ----------
# notify <제목> <본문> <priority: default|high> <tags>
notify() {
  local title="$1" body="$2" prio="${3:-default}" tags="${4:-}" sent=0
  if [ -z "$NTFY_TOPIC" ] && [ -z "$TELEGRAM_BOT_TOKEN" ]; then
    die "알림 채널이 설정되지 않았습니다. $CONF 에 NTFY_TOPIC 또는 TELEGRAM_* 를 지정하세요."
  fi
  if [ -n "$NTFY_TOPIC" ]; then
    # 한글 제목은 RFC 2047 인코딩으로 헤더에 실음 (ntfy 지원)
    local etitle="=?UTF-8?B?$(printf '%s' "$title" | base64 | tr -d '\n')?="
    local args=(-sS -m 20 -o /dev/null -w '%{http_code}'
                -H "Title: $etitle" -H "Priority: $prio")
    [ -n "$tags" ] && args+=(-H "Tags: $tags")
    [ -n "$NTFY_TOKEN" ] && args+=(-H "Authorization: Bearer $NTFY_TOKEN")
    local code
    code=$(printf '%s' "$body" | curl "${args[@]}" --data-binary @- "$NTFY_SERVER/$NTFY_TOPIC") || code=000
    if [ "${code:0:1}" = 2 ]; then sent=1; else echo "mdnotify: ntfy 전송 실패 (HTTP $code)" >&2; fi
  fi
  if [ -n "$TELEGRAM_BOT_TOKEN" ] && [ -n "$TELEGRAM_CHAT_ID" ]; then
    if curl -sS -m 20 -o /dev/null --fail \
         --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
         --data-urlencode "text=$title
$body" \
         "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage"; then
      sent=1
    else
      echo "mdnotify: Telegram 전송 실패" >&2
    fi
  fi
  [ "$sent" = 1 ]
}

fmt_dur() { local s=$1; printf '%dh %02dm %02ds' $((s/3600)) $((s%3600/60)) $((s%60)); }

# MD 로그에서 요약 추출 (GROMACS / LAMMPS / AMBER / NAMD)
log_summary() {
  local f="$1" out=""
  [ -f "$f" ] || return 0
  # GROMACS: "Performance:  123.4  0.194" (ns/day, hour/ns)
  out=$(grep -E '^Performance:' "$f" | tail -1 | awk '{print "성능: "$2" ns/day"}')
  # LAMMPS: "Performance: 12.3 ns/day, ..."
  [ -z "$out" ] && out=$(grep -E '^Performance: .*ns/day' "$f" | tail -1 | sed -E 's/^Performance: ([0-9.]+) ns\/day.*/성능: \1 ns\/day/')
  # AMBER (pmemd mdout): "|         ns/day =      85.12   seconds/ns = ..."
  [ -z "$out" ] && out=$(grep -E 'ns/day *=' "$f" | tail -1 | sed -E 's/.*ns\/day *= *([0-9.]+).*/성능: \1 ns\/day/')
  # NAMD: "Info: Benchmark time: ... days/ns"
  [ -z "$out" ] && out=$(grep -E 'Benchmark time:.*days/ns' "$f" | tail -1 | sed -E 's/.* ([0-9.e+-]+) days\/ns.*/성능: \1 days\/ns/')
  [ -n "$out" ] && printf '%s\n' "$out"
  printf -- '--- %s (마지막 5줄) ---\n' "$(basename "$f")"
  tail -n 5 "$f"
}

# ---------- 명령 ----------
cmd_run() {
  local name="" log=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --log)  log="$2";  shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || die "실행할 명령이 없습니다. 예: mdnotify run --log md.log -- gmx mdrun -deffnm md"
  [ -n "$name" ] || name="${SLURM_JOB_NAME:-${PBS_JOBNAME:-$(basename "$1")}}"

  local tmp; tmp=$(mktemp)
  local start=$SECONDS rc
  # 출력은 그대로 터미널/로그로 보내고, 꼬리만 따로 보관
  "$@" 2>&1 | tee "$tmp"
  rc=${PIPESTATUS[0]}
  local dur=$((SECONDS - start))

  local body
  body="호스트: $HOST${SLURM_JOB_ID:+ (Slurm $SLURM_JOB_ID)}
디렉터리: $PWD
소요 시간: $(fmt_dur $dur)
종료 코드: $rc"
  if [ -n "$log" ] && [ -f "$log" ]; then
    body="$body
$(log_summary "$log")"
  else
    body="$body
--- 출력 (마지막 5줄) ---
$(tail -n 5 "$tmp")"
  fi
  rm -f "$tmp"

  if [ "$rc" -eq 0 ]; then
    notify "✅ MD 완료: $name" "$body" default "white_check_mark"
  else
    notify "❌ MD 실패: $name" "$body" high "x"
  fi
  return "$rc"
}

cmd_watch() {
  local name="" interval=60 pattern=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)     name="$2"; shift 2 ;;
      --interval) interval="$2"; shift 2 ;;
      --pattern)  pattern="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  local f="${1:-}"
  [ -n "$f" ] || die "감시할 파일을 지정하세요. 예: mdnotify watch md.gro"
  [ -n "$name" ] || name="$(basename "$PWD")/$(basename "$f")"
  echo "mdnotify: '$f' 감시 시작 (간격 ${interval}s${pattern:+, 패턴: $pattern})" >&2
  while :; do
    if [ -f "$f" ]; then
      if [ -z "$pattern" ] || grep -Eq "$pattern" "$f"; then break; fi
    fi
    sleep "$interval"
  done
  notify "✅ MD 결과 생성: $name" "호스트: $HOST
디렉터리: $PWD
파일: $f
$(log_summary "$f")" default "white_check_mark"
}

case "${1:-}" in
  send)  shift; notify "${1:?제목 필요}" "${2:-}" "${3:-default}" "${4:-}" ;;
  run)   shift; cmd_run "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  test)  notify "🔔 mdnotify 테스트" "$HOST 에서 보낸 테스트 알림입니다." default "bell" && echo "전송 완료" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
